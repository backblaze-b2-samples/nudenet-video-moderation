# Backblaze B2 (required) — S3-compatible API
# The S3 endpoint is derived from B2_REGION as
#   https://s3.<B2_REGION>.backblazeb2.com
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004
# Optional: a public/CDN base URL for objects (leave blank to use presigned URLs)
B2_PUBLIC_URL_BASE=

# Example of what filled-in B2 values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=<your-32-char-application-key>
# B2_BUCKET_NAME=my-moderation-bucket
# B2_REGION=us-west-004

# --- Moderation pipeline defaults (optional; all have safe defaults) ---
# Detection confidence floor (0.0-1.0). A frame is flagged only when a
# detection scores >= this AND its class is in VIOLATION_LABELS.
# MODERATION_THRESHOLD=0.25
# Frame sampling strategy: "fps" or "keyframes"
# SAMPLE_MODE=fps
# Frames per second to sample when SAMPLE_MODE=fps
# SAMPLE_FPS=1
# Comma-separated NudeNet classes treated as policy violations
# VIOLATION_LABELS=FEMALE_GENITALIA_EXPOSED,MALE_GENITALIA_EXPOSED,FEMALE_BREAST_EXPOSED,BUTTOCKS_EXPOSED,ANUS_EXPOSED
# Max uploaded video size in bytes (default 500MB)
# MAX_VIDEO_SIZE=524288000
