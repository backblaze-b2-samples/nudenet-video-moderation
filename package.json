{
  "name": "nudenet-video-moderation",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @nudenet-video-moderation/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @nudenet-video-moderation/web build",
    "typecheck": "pnpm --filter @nudenet-video-moderation/web typecheck",
    "lint": "pnpm --filter @nudenet-video-moderation/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @nudenet-video-moderation/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@hono/node-server": "1.19.15",
      "ajv@<7": "6.14.0",
      "ajv@>=7 <8.18.0": "8.18.0",
      "body-parser": "2.3.0",
      "brace-expansion": "1.1.18",
      "express-rate-limit": "8.2.2",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "minimatch": "3.1.5",
      "nanoid": "3.3.18",
      "path-to-regexp@>=8 <8.4.0": "8.4.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <4.0.5": "4.0.5",
      "postcss": "8.5.26",
      "postcss-selector-parser": "7.1.3",
      "qs": "6.15.2",
      "sharp": "0.35.3",
      "shell-quote": "1.9.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
